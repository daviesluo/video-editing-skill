# Copy to .env (gitignored) and fill in. Keys never go in the repository or
# in a chat; a cloud session gets them from its environment's secrets.
ELEVENLABS_API_KEY=
# Or, instead of a key on this machine, a relay that holds the key
# server-side and forwards a short allowlist of calls:
ELEVENLABS_PROXY_URL=
ELEVENLABS_PROXY_TOKEN=
